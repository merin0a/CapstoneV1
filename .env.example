PORT=3000
HOST=127.0.0.1
# Leave empty to use the local PGlite database in data/pgdata.
DATABASE_URL=
# Optional alternative location for the local database:
# DATA_DIR=./data/pgdata
# Demo accounts are only created when this is true. Use false with real data.
SEED_DEMO=true
# Optional demo password override (at least 10 characters):
# DEMO_PASSWORD=
# For an HTTPS deployment, also set NODE_ENV=production and APP_ORIGIN.
# APP_ORIGIN=https://your-domain.example
